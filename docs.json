{
  "$schema": "https://mintlify.com/docs.json",
  "name": "FirstFifty",
  "description": "FirstFifty connects makers of experimental apps with their first believers through numbered seats, devlogs, and an optional token launch on Monad.",
  "theme": "willow",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://firstfifty.xyz"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#b8861a",
    "light": "#d4a024",
    "dark": "#a07314"
  },
  "background": {
    "color": {
      "light": "#fafaf7",
      "dark": "#0f0f0f"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Launch Your App",
      "href": "https://firstfifty.xyz/dashboard/apps/new"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "how-it-works",
              "create-account"
            ]
          },
          {
            "group": "For Makers",
            "pages": [
              "makers/overview",
              "makers/app-page",
              "makers/devlog",
              "makers/tiers-and-perks",
              "makers/token-launch"
            ]
          },
          {
            "group": "For Early Adopters",
            "pages": [
              "adopters/overview",
              "adopters/tiers",
              "adopters/contribution-points",
              "adopters/leaderboards"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "platform/discover",
              "platform/community-features",
              "platform/faq"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://firstfifty.xyz"
    }
  }
}
